# Copy to apps/mobile/.env. Every EXPO_PUBLIC_ value is bundled into the app: never put a secret here.
# Full reference: docs/guides/environment-setup.md

# Supabase (local: run `supabase status`; on a physical phone use your computer's LAN IP, not 127.0.0.1)
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Maps (optional locally)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_MAPBOX_TOKEN=

# Sentry (optional; falls back to the DSN in code)
EXPO_PUBLIC_SENTRY_DSN=

# Optional: set to true to fetch Android push tokens without google-services.json
EXPO_PUBLIC_ENABLE_PUSH=
