# Copy to apps/web/.env.local. Full reference: docs/guides/environment-setup.md
# Only NEXT_PUBLIC_ values reach the browser. Never rename a secret to NEXT_PUBLIC_.

# Supabase (local: run `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Sentry (optional; falls back to the DSN in code)
NEXT_PUBLIC_SENTRY_DSN=

# Contact form (/api/contact): server-only secrets. Leave blank unless you're working on it.
SUPABASE_SERVICE_ROLE_KEY=
SENDGRID_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_NOTIFY_EMAILS=

# Vercel builds only: uploads source maps to Sentry
SENTRY_AUTH_TOKEN=
