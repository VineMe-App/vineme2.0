{
  "name": "Enforce branch naming convention",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": [
        "refs/heads/dev",
        "refs/heads/main",
        "refs/heads/feat/*",
        "refs/heads/fix/*",
        "refs/heads/chore/*",
        "refs/heads/docs/*",
        "refs/heads/refactor/*",
        "refs/heads/release/*",
        "refs/heads/revert-*",
        "refs/heads/dependabot/*"
      ]
    }
  },
  "rules": [
    {
      "type": "creation"
    }
  ]
}
