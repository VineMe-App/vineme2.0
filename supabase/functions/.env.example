# Copy to supabase/functions/.env for local Edge Functions. Full reference: docs/guides/environment-setup.md
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically: don't set them.

# Marks this as a dev environment so dev-impersonate-user can run. Never set in production.
APP_ENV=development

# ChurchSuite (local mocks: docker compose up churchsuite mocks)
CHURCHSUITE_API_URL=http://churchsuite:4010
CHURCHSUITE_AUTH_API_URL=
# Must equal the edge_fn_webhook_secret Vault value. See the guide for the command to read it.
CHURCHSUITE_WEBHOOK_SECRET=

# Email (optional locally)
SENDGRID_API_KEY=
EXPORT_FROM_EMAIL=
MISSING_SERVICE_FROM_EMAIL=
MISSING_SERVICE_TO_EMAIL=
