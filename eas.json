{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
        "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_CHURCHSUITE_TEST_EMAIL_DOMAINS": "example.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_CHURCHSUITE_TEST_EMAIL_DOMAINS": "example.com"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_CHURCHSUITE_TEST_EMAIL_DOMAINS": "example.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}