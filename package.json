{
  "name": "vineme-mobile-app",
  "version": "2.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:expo-go": "USE_EXPO_GO=true expo start --clear",
    "start:dev-client": "expo start --dev-client --clear",
    "android": "expo start --dev-client",
    "android:expo-go": "USE_EXPO_GO=true expo start --clear",
    "android:simulator": "expo start --dev-client --android",
    "ios": "expo start --dev-client",
    "ios:expo-go": "USE_EXPO_GO=true expo start --clear",
    "ios:simulator": "expo start --dev-client --ios",
    "web": "expo start --web",
    "firewall:enable": "./scripts/expo-firewall-setup.sh enable",
    "firewall:disable": "./scripts/expo-firewall-setup.sh disable",
    "firewall:status": "./scripts/expo-firewall-setup.sh status",
    "network:debug": "./scripts/network-troubleshoot.sh",
    "cron:status": "supabase db query --local \"select jobid, jobname, schedule, active from cron.job;\"",
    "cron:disable": "supabase db query --local \"select cron.unschedule('sync-churchsuite-vulnerable-tags-daily');\"",
    "cron:enable": "supabase db query --local \"select public.reschedule_churchsuite_vulnerable_tags_sync();\"",
    "webhook:sync-secret": "./scripts/sync-webhook-secret.sh",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --watchAll=false --passWithNoTests",
    "test:unit": "jest --testPathPatterns='src/(services|hooks|utils|components|stores|providers).*\\.test\\.(ts|tsx)$'",
    "test:integration": "jest --testPathPatterns='src/__tests__/integration.*\\.test\\.(ts|tsx)$'",
    "test:e2e": "jest --testPathPatterns='src/__tests__/e2e.*\\.test\\.(ts|tsx)$'",
    "test:ios": "expo start --ios --clear",
    "test:android": "expo start --android --clear",
    "build:ios": "expo build:ios",
    "build": "eas build --profile development --platform android",
    "preview:ios": "expo install --ios && expo start --ios",
    "preview:android": "expo install --android && expo start --android"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.3.18",
    "@supabase/supabase-js": "^2.54.0",
    "@tanstack/react-query": "^5.84.2",
    "@totallymoney/filename-basepath": "^0.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "body-parser": "^2.2.2",
    "eas-cli": "^23.2.0",
    "expo": "^57.0.21",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "express": "^5.2.1",
    "pngjs": "^7.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@eslint/js": "^9.33.0",
    "@expo/config-plugins": "~54.0.1",
    "@expo/ngrok": "^4.1.3",
    "@expo/prebuild-config": "~54.0.0",
    "@tanstack/react-query-devtools": "^5.84.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.2",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "^30.0.5",
    "lint-staged": "^16.2.4",
    "metro": "^0.83.1",
    "metro-config": "^0.83.1",
    "metro-resolver": "^0.83.1",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
